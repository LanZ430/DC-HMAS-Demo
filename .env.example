# Copy to .env and fill in your own key (never commit .env)
#
# Demo mode: hides internal agent debug sidebar (default on for public repo)
DC_HMAS_DEMO=1

# DashScope / 阿里云百炼 OpenAI-compatible endpoint
DASHSCOPE_API_KEY=your_key_here
# or: LLM_API_KEY=your_key_here

LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# Optional: image generation (off by default in UI; needs Wanx on your account)
# DC_HMAS_ENABLE_IMAGE=0
# DC_HMAS_WANX_MODEL=wanx2.1-t2i-turbo

# Optional paths & budgets
# DC_HMAS_DATA_DIR=./data
# DC_HMAS_FOREGROUND_SEC=180
